# Database Configuration
# Required: PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/careerpilot

# JWT Configuration
# Required: Secure random strings (use: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-secret-access-key-here-use-openssl-rand-base64-32
JWT_REFRESH_SECRET=your-secret-refresh-key-here-use-openssl-rand-base64-32
JWT_RESET_SECRET=your-secret-reset-key-here-use-openssl-rand-base64-32

# JWT Expiration Times
# Default values shown - can be customized
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=15m

# SMTP Email Configuration
# Optional: If not set, email features will be disabled
# Required if you want email verification and password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@careerpilot.com
SMTP_SECURE=false

# Bcrypt Configuration
# Salt rounds for password hashing (12 is recommended for security vs performance balance)
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
# Configure throttle/rate limiting (global default)
# TTL in milliseconds, LIMIT is number of requests per TTL window
# Default: 200 requests / 60 seconds. Auth routes use stricter limits.
THROTTLE_TTL=60000
THROTTLE_LIMIT=200

# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins for CORS.
# Must be the EXACT origin(s) of the frontend — never "*" (credentials
# are enabled, so browsers reject wildcard CORS).
CORS_ORIGIN=http://localhost:3000

# Cookie architecture:
# - Same-site deployment (frontend served from the same origin as the
#   API, e.g. behind one reverse proxy): leave unset/false — the refresh
#   cookie stays SameSite=strict (strongest option).
# - Cross-site deployment (frontend and backend on different origins,
#   the current direct-frontend architecture): set to true so the
#   refresh cookie is emitted as SameSite=None; Secure. Requires HTTPS
#   in production; browsers reject SameSite=None over plain HTTP.
COOKIE_CROSS_SITE=false

# Google OAuth (sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# In Google Cloud Console, the OAuth client's "Authorized redirect URIs"
# must contain exactly the value below (backend origin + /auth/google/callback).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-host/auth/google/callback

# Google Gemini AI Configuration
# Optional app-level key used when the user has not configured their own key.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# Required for encrypting user Gemini keys before storing them in PostgreSQL.
GEMINI_ENCRYPTION_KEY=replace-with-a-32-byte-secret

# Optional: Database Seed
# Uncomment to seed database with test data
# DATABASE_SEED=true

# Optional: Logging
# LOG_LEVEL=debug

# Optional: Email Queue
# For production, consider using BullMQ + Redis
# REDIS_URL=redis://localhost:6379
# QUEUE_ENABLED=true
