# Frontend environment template — copy to .env and fill real values.
# Never commit real secrets; .env* is git-ignored.

# Two operating modes — pick ONE:
#
# ── Mode A (recommended in production): same-origin API gateway ──
# The browser talks only to this app's own origin; the Next server
# forwards /api/* to the backend server-side. Auth cookies stay
# first-party (SameSite=strict cookies are rejected cross-origin,
# which silently breaks session persistence) and CORS is out of play.
#   NEXT_PUBLIC_API_URL=/api
#   API_PROXY_TARGET=https://your-backend-host
#
# ── Mode B: direct cross-origin API ──
# Works only when cookies/CORS are deliberately configured for it
# (backend CORS_ORIGIN must allow this exact origin, and the refresh
# cookie must be SameSite=None; Secure to survive cross-site).
#   NEXT_PUBLIC_API_URL=https://your-backend-host
#   (API_PROXY_TARGET unset)
NEXT_PUBLIC_API_URL=

# Server-side gateway target for /api/* rewrites (Mode A). Read by
# next.config.ts on the server only; never bundled into client code.
# API_PROXY_TARGET=
