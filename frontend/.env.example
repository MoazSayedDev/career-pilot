# Frontend environment template — copy to .env and fill real values.
# Never commit real secrets; .env* is git-ignored (only this template is tracked).

# Base URL of the backend API. This value is PUBLIC: Next.js inlines any
# NEXT_PUBLIC_* variable into the shipped client JavaScript, so it must
# never contain tokens, passwords, or admin endpoints.
#
# The frontend calls the backend DIRECTLY (no Next.js proxy). For auth
# cookies to work across the two origins, the backend must be configured
# for the cross-site architecture — see its .env.example:
#   CORS_ORIGIN=https://your-frontend-host   (exact origin, no wildcard)
#   COOKIE_CROSS_SITE=true                   (SameSite=None; Secure cookie)
NEXT_PUBLIC_API_URL=https://your-backend-host
